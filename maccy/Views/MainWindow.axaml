<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:maccy.ViewModels"
        xmlns:m="using:maccy.Models"
        xmlns:conv="using:maccy.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="maccy.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Maccy for Win"
        Width="360"
        Height="620"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="False"
        CanResize="False"
        SystemDecorations="None"
        Background="Transparent">

    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="Background" Value="{DynamicResource AppControlBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppControlHoverBackground}" />
        </Style>
        <Style Selector="Button:pressed">
            <Setter Property="Background" Value="{DynamicResource AppControlPressedBackground}" />
        </Style>

        <Style Selector="Border#CommonMenuEntry:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppControlHoverBackground}" />
        </Style>
        <Style Selector="Border#CommonMenuEntry:pressed">
            <Setter Property="Background" Value="{DynamicResource AppControlPressedBackground}" />
        </Style>

        <Style Selector="Border#AuthorEntry:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppControlHoverBackground}" />
        </Style>
        <Style Selector="Border#AuthorEntry:pressed">
            <Setter Property="Background" Value="{DynamicResource AppControlPressedBackground}" />
        </Style>

        <Style Selector="Border.draggableRow">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.draggableRow.dragging">
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="RenderTransform" Value="scale(1.03)" />
            <Setter Property="Cursor" Value="SizeAll" />
        </Style>

        <Style Selector="ListBoxItem.drag-over /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppControlPressedBackground}" />
        </Style>
        <Style Selector="ListBoxItem.drop-flash /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppControlHoverBackground}" />
        </Style>
    </Window.Styles>

    <Window.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding HideCommand}" />
        <KeyBinding Gesture="Enter" Command="{Binding ApplySelectedCommand}" />
        <KeyBinding Gesture="Delete" Command="{Binding DeleteSelectedCommand}" />
        <KeyBinding Gesture="Ctrl+P" Command="{Binding TogglePinCommand}" />
        <KeyBinding Gesture="Ctrl+F" Command="{Binding FocusSearchCommand}" />
    </Window.KeyBindings>

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Border Background="{DynamicResource AppBackground}"
            BorderBrush="{DynamicResource AppDivider}"
            BorderThickness="1"
            CornerRadius="14"
            ClipToBounds="True"
            PointerPressed="OnWindowPointerPressed">
        <Grid>
            <DockPanel LastChildFill="True">
            <Border DockPanel.Dock="Top"
                    Padding="10,8"
                    Background="{DynamicResource AppPanelBackground}"
                    BorderBrush="{DynamicResource AppDivider}"
                    BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Border Padding="10,4"
                            Name="AuthorEntry"
                            Background="{DynamicResource AppControlBackground}"
                            BorderBrush="{DynamicResource AppBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            PointerPressed="OnAuthorPressed">
                        <TextBlock Text="About"
                                   Foreground="{DynamicResource AppMutedForeground}"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                    </Border>

                    <TextBox Grid.Column="1"
                             Name="SearchBox"
                             Text="{Binding SearchText}"
                             Watermark="搜索"
                             Height="30"
                             Background="{DynamicResource AppControlBackground}"
                             Foreground="{DynamicResource AppForeground}"
                             BorderBrush="{DynamicResource AppBorder}" />
                </Grid>
            </Border>

            <Border DockPanel.Dock="Bottom"
                    Padding="10,8"
                    Background="{DynamicResource AppPanelBackground}"
                    BorderBrush="{DynamicResource AppDivider}"
                    BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AppMuted2Foreground}"
                               FontSize="11"
                               Text="{Binding VersionText}" />

                    <Border Grid.Column="1"
                            VerticalAlignment="Center"
                            Background="{DynamicResource AppControlBackground}"
                            BorderBrush="{DynamicResource AppBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,6"
                            ClipToBounds="True"
                            MinWidth="0"
                            IsVisible="{Binding IsSyncProgressVisible}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" MinWidth="0">
                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource AppMutedForeground}"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"
                                       MaxWidth="120"
                                       Text="{Binding SyncProgressText}" />
                            <ProgressBar Grid.Column="1"
                                         Height="12"
                                         Minimum="0"
                                         Maximum="100"
                                         MinWidth="0"
                                         Value="{Binding SyncProgressPercent}" />
                        </Grid>
                    </Border>

                    <Grid Grid.Column="2" VerticalAlignment="Center" Width="18" Height="18" ToolTip.Tip="{Binding SyncIconToolTip}">
                        <Viewbox Width="18" Height="18" Stretch="Uniform" IsVisible="{Binding ShowSyncIdleIcon}">
                            <Canvas Width="24" Height="24">
                                <Path Data="M 7.5 18.8 C 5.0 18.8 3.0 16.8 3.0 14.4 C 3.0 12.1 4.6 10.2 6.9 9.8 C 7.5 6.9 10.0 4.8 13.0 4.8 C 16.4 4.8 19.1 7.2 19.7 10.4 C 21.7 10.8 23.2 12.5 23.2 14.8 C 23.2 17.0 21.4 18.8 19.1 18.8 L 7.5 18.8"
                                      Stroke="{DynamicResource AppMuted2Foreground}"
                                      StrokeThickness="1.8"
                                      StrokeLineCap="Round"
                                      Fill="Transparent" />
                            </Canvas>
                        </Viewbox>

                        <Viewbox Width="18" Height="18" Stretch="Uniform" IsVisible="{Binding ShowSyncWorkingIcon}">
                            <Canvas Width="24" Height="24">
                                <Path Data="M 7.5 18.8 C 5.0 18.8 3.0 16.8 3.0 14.4 C 3.0 12.1 4.6 10.2 6.9 9.8 C 7.5 6.9 10.0 4.8 13.0 4.8 C 16.4 4.8 19.1 7.2 19.7 10.4 C 21.7 10.8 23.2 12.5 23.2 14.8 C 23.2 17.0 21.4 18.8 19.1 18.8 L 7.5 18.8"
                                      Stroke="#F59E0B"
                                      StrokeThickness="1.8"
                                      StrokeLineCap="Round"
                                      Fill="Transparent" />
                                <Path Data="M 8.0 13.2 C 9.0 11.3 11.1 10.3 13.1 10.6 L 12.1 9.5 M 13.2 10.6 L 12.1 9.5 M 16.0 11.0 C 15.5 13.2 13.5 14.7 11.3 14.6 L 12.4 15.7 M 11.2 14.6 L 12.4 15.7"
                                      Stroke="#F59E0B"
                                      StrokeThickness="1.7"
                                      StrokeLineCap="Round"
                                      Fill="Transparent" />
                            </Canvas>
                        </Viewbox>

                        <Viewbox Width="18" Height="18" Stretch="Uniform" IsVisible="{Binding ShowSyncSuccessIcon}">
                            <Canvas Width="24" Height="24">
                                <Path Data="M 7.5 18.8 C 5.0 18.8 3.0 16.8 3.0 14.4 C 3.0 12.1 4.6 10.2 6.9 9.8 C 7.5 6.9 10.0 4.8 13.0 4.8 C 16.4 4.8 19.1 7.2 19.7 10.4 C 21.7 10.8 23.2 12.5 23.2 14.8 C 23.2 17.0 21.4 18.8 19.1 18.8 L 7.5 18.8"
                                      Stroke="#10B981"
                                      StrokeThickness="1.8"
                                      StrokeLineCap="Round"
                                      Fill="Transparent" />
                                <Path Data="M 9.0 13.0 L 11.6 15.5 L 16.0 10.8"
                                      Stroke="#10B981"
                                      StrokeThickness="2.0"
                                      StrokeLineCap="Round"
                                      Fill="Transparent" />
                            </Canvas>
                        </Viewbox>

                        <Viewbox Width="18" Height="18" Stretch="Uniform" IsVisible="{Binding ShowSyncErrorIcon}">
                            <Canvas Width="24" Height="24">
                                <Path Data="M 7.5 18.8 C 5.0 18.8 3.0 16.8 3.0 14.4 C 3.0 12.1 4.6 10.2 6.9 9.8 C 7.5 6.9 10.0 4.8 13.0 4.8 C 16.4 4.8 19.1 7.2 19.7 10.4 C 21.7 10.8 23.2 12.5 23.2 14.8 C 23.2 17.0 21.4 18.8 19.1 18.8 L 7.5 18.8"
                                      Stroke="#EF4444"
                                      StrokeThickness="1.8"
                                      StrokeLineCap="Round"
                                      Fill="Transparent" />
                                <Path Data="M 10.0 10.8 L 15.0 15.8 M 15.0 10.8 L 10.0 15.8"
                                      Stroke="#EF4444"
                                      StrokeThickness="2.0"
                                      StrokeLineCap="Round"
                                      Fill="Transparent" />
                            </Canvas>
                        </Viewbox>
                    </Grid>

                    <Button Grid.Column="3" Content="设置" Command="{Binding OpenPreferencesCommand}" />
                    <Button Grid.Column="4" Content="清除" Click="OnClearAllClick" />
                </Grid>
            </Border>

            <Grid RowDefinitions="Auto,*">
                <Border Grid.Row="0"
                        Name="CommonMenuEntry"
                        IsVisible="{Binding ShowCommonRoot}"
                        Background="Transparent"
                        Cursor="Hand"
                        ToolTip.Tip="打开常用剪贴"
                        PointerPressed="OnCommonMenuPressed">
                    <Grid RowDefinitions="Auto,Auto">
                        <Border Grid.Row="0" Padding="10,7" Background="Transparent">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0"
                                           Text="常用剪贴"
                                           Foreground="{DynamicResource AppForeground}"
                                           FontSize="13" />
                                <TextBlock Grid.Column="1"
                                           Text="›"
                                           Margin="10,0,0,0"
                                           Foreground="{DynamicResource AppMuted2Foreground}"
                                           FontSize="16"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Height="1" Background="{DynamicResource AppDivider}" HorizontalAlignment="Stretch" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1" IsVisible="{Binding ShowFavoritesFolder}" RowDefinitions="Auto,*">
                    <Border Grid.Row="0"
                            Padding="10,6"
                            Background="{DynamicResource AppPanelBackground}"
                            BorderBrush="{DynamicResource AppDivider}"
                            BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Button Grid.Column="0" Content="返回" Command="{Binding BackCommonSectionCommand}" />
                            <TextBlock Grid.Column="1" Text="常用剪贴" Foreground="{DynamicResource AppForeground}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="1"
                             Name="PinnedList"
                             ItemsSource="{Binding PinnedFilteredItems}"
                             SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                             PointerEntered="HistoryListOnPointerEntered"
                             PointerExited="HistoryListOnPointerExited"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Visible"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="ContextMenu">
                                    <ContextMenu>
                                        <MenuItem Header="加入收藏/取消收藏"
                                                  Click="OnTogglePinMenuClick" />
                                        <MenuItem Header="添加备注"
                                                  Click="OnEditNoteMenuClick" />
                                        <Separator />
                                        <MenuItem Header="删除"
                                                  Click="OnDeleteMenuClick" />
                                    </ContextMenu>
                                </Setter>
                            </Style>
                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource AppControlHoverBackground}" />
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource AppControlPressedBackground}" />
                            </Style>
                            <Style Selector="ListBoxItem:nth-child(odd) TextBlock.rowtext">
                                <Setter Property="Foreground" Value="{DynamicResource AppMutedForeground}" />
                            </Style>
                            <Style Selector="ListBoxItem:nth-child(even) TextBlock.rowtext">
                                <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="m:ClipboardItem">
                                <Grid RowDefinitions="Auto,Auto">
                                    <Border Grid.Row="0" Padding="10,7"
                                            Background="Transparent"
                                            Classes="draggableRow"
                                            PointerPressed="OnRowPointerPressed"
                                            PointerMoved="OnRowPointerMoved"
                                            PointerReleased="OnRowPointerReleased"
                                            PointerEntered="HistoryRowOnPointerEntered"
                                            PointerExited="HistoryRowOnPointerExited">
                                        <Grid ColumnDefinitions="Auto,*,Auto"
                                              RowDefinitions="Auto"
                                              ColumnSpacing="10">

                                            <TextBlock Grid.Column="0"
                                                       Width="16"
                                                       VerticalAlignment="Center"
                                                       Foreground="#D8C05E"
                                                       FontSize="12"
                                                       Text="★"
                                                       IsVisible="{Binding Pinned}" />

                                            <Border Grid.Column="2"
                                                    Width="44"
                                                    Height="18"
                                                    CornerRadius="4"
                                                    Background="{DynamicResource AppControlBackground}"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding Kind, Converter={x:Static conv:KindEqualsConverter.Instance}, ConverterParameter=FileList}">
                                                <TextBlock Text="{Binding FilePaths, Converter={x:Static conv:FilePathsToExtensionTagConverter.Instance}}"
                                                           Foreground="{DynamicResource AppMutedForeground}"
                                                           FontSize="9"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Border>

                                            <Border Grid.Column="2"
                                                    Width="44"
                                                    Height="18"
                                                    CornerRadius="4"
                                                    Background="{DynamicResource AppControlBackground}"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding Kind, Converter={x:Static conv:KindEqualsConverter.Instance}, ConverterParameter=Image}">
                                                <TextBlock Text="IMG"
                                                           Foreground="{DynamicResource AppMutedForeground}"
                                                           FontSize="9"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Border>

                                            <TextBlock Grid.Column="1"
                                                       Grid.Row="0"
                                                       Text="{Binding Text, Converter={x:Static conv:TextToSingleLineConverter.Instance}}"
                                                       Classes="rowtext"
                                                       FontSize="13"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       IsVisible="{Binding Kind, Converter={x:Static conv:KindEqualsConverter.Instance}, ConverterParameter=Text}">
                                            </TextBlock>

                                            <TextBlock Grid.Column="1"
                                                       Grid.Row="0"
                                                       Text="{Binding FilePaths, Converter={x:Static conv:FilePathsToSummaryStringConverter.Instance}}"
                                                       Classes="rowtext"
                                                       FontSize="13"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       IsVisible="{Binding Kind, Converter={x:Static conv:KindEqualsConverter.Instance}, ConverterParameter=FileList}">
                                            </TextBlock>

                                            <Grid Grid.Column="1"
                                                  ColumnDefinitions="Auto,*"
                                                  ColumnSpacing="10"
                                                  VerticalAlignment="Center"
                                                  IsVisible="{Binding Kind, Converter={x:Static conv:KindEqualsConverter.Instance}, ConverterParameter=Image}">
                                                <Border Grid.Column="0"
                                                        Width="36"
                                                        Height="36"
                                                        CornerRadius="6"
                                                        Background="{DynamicResource AppControlBackground}"
                                                        VerticalAlignment="Center">
                                                    <Image Width="36"
                                                           Height="36"
                                                           Stretch="UniformToFill"
                                                           Source="{Binding ImageFilePath, Converter={x:Static conv:ImagePathToBitmapConverter.Instance}}" />
                                                </Border>

                                                <TextBlock Grid.Column="1"
                                                           Grid.Row="0"
                                                           Text="{Binding ImageFilePath, Converter={x:Static conv:ImagePathToImageInfoConverter.Instance}}"
                                                           Classes="rowtext"
                                                           FontSize="13"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Row="1"
                                            Height="1"
                                            Background="{DynamicResource AppDivider}"
                                            HorizontalAlignment="Stretch" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <ListBox Grid.Row="1"
                         Name="HistoryList"
                         IsVisible="{Binding ShowCommonRoot}"
                         ItemsSource="{Binding FilteredItems}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         PointerEntered="HistoryListOnPointerEntered"
                         PointerExited="HistoryListOnPointerExited"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Visible"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="ContextMenu">
                                <ContextMenu>
                                    <MenuItem Header="加入收藏/取消收藏"
                                              Click="OnTogglePinMenuClick" />
                                    <MenuItem Header="添加备注"
                                              Click="OnEditNoteMenuClick" />
                                    <Separator />
                                    <MenuItem Header="删除"
                                              Click="OnDeleteMenuClick" />
                                </ContextMenu>
                            </Setter>
                        </Style>
                        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="{DynamicResource AppControlHoverBackground}" />
                        </Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="{DynamicResource AppControlPressedBackground}" />
                        </Style>
                        <Style Selector="ListBoxItem:nth-child(odd) TextBlock.rowtext">
                            <Setter Property="Foreground" Value="{DynamicResource AppMutedForeground}" />
                        </Style>
                        <Style Selector="ListBoxItem:nth-child(even) TextBlock.rowtext">
                            <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="m:ClipboardItem">
                            <Grid RowDefinitions="Auto,Auto">
                                <Border Grid.Row="0" Padding="10,7"
                                        Background="Transparent"
                                        Classes="draggableRow"
                                        PointerPressed="OnRowPointerPressed"
                                        PointerMoved="OnRowPointerMoved"
                                        PointerReleased="OnRowPointerReleased"
                                        PointerEntered="HistoryRowOnPointerEntered"
                                        PointerExited="HistoryRowOnPointerExited">
                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                          RowDefinitions="Auto"
                                          ColumnSpacing="10">

                                        <TextBlock Grid.Column="0"
                                                   Width="16"
                                                   VerticalAlignment="Center"
                                                   Foreground="#D8C05E"
                                                   FontSize="12"
                                                   Text="★"
                                                   IsVisible="{Binding Pinned}" />

                                        <Border Grid.Column="2"
                                                Width="44"
                                                Height="18"
                                                CornerRadius="4"
                                                Background="{DynamicResource AppControlBackground}"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding Kind, Converter={x:Static conv:KindEqualsConverter.Instance}, ConverterParameter=FileList}">
                                            <TextBlock Text="{Binding FilePaths, Converter={x:Static conv:FilePathsToExtensionTagConverter.Instance}}"
                                                       Foreground="{DynamicResource AppMutedForeground}"
                                                       FontSize="9"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Border>

                                        <Border Grid.Column="2"
                                                Width="44"
                                                Height="18"
                                                CornerRadius="4"
                                                Background="{DynamicResource AppControlBackground}"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding Kind, Converter={x:Static conv:KindEqualsConverter.Instance}, ConverterParameter=Image}">
                                            <TextBlock Text="IMG"
                                                       Foreground="{DynamicResource AppMutedForeground}"
                                                       FontSize="9"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Border>

                                        <TextBlock Grid.Column="1"
                                                   Grid.Row="0"
                                                   Text="{Binding Text, Converter={x:Static conv:TextToSingleLineConverter.Instance}}"
                                                   Classes="rowtext"
                                                   FontSize="13"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   IsVisible="{Binding Kind, Converter={x:Static conv:KindEqualsConverter.Instance}, ConverterParameter=Text}">
                                        </TextBlock>

                                        <TextBlock Grid.Column="1"
                                                   Grid.Row="0"
                                                   Text="{Binding FilePaths, Converter={x:Static conv:FilePathsToSummaryStringConverter.Instance}}"
                                                   Classes="rowtext"
                                                   FontSize="13"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   IsVisible="{Binding Kind, Converter={x:Static conv:KindEqualsConverter.Instance}, ConverterParameter=FileList}">
                                        </TextBlock>

                                        <Grid Grid.Column="1"
                                              ColumnDefinitions="Auto,*"
                                              ColumnSpacing="10"
                                              VerticalAlignment="Center"
                                              IsVisible="{Binding Kind, Converter={x:Static conv:KindEqualsConverter.Instance}, ConverterParameter=Image}">
                                            <Border Grid.Column="0"
                                                    Width="36"
                                                    Height="36"
                                                    CornerRadius="6"
                                                    Background="{DynamicResource AppControlBackground}"
                                                    VerticalAlignment="Center">
                                                <Image Width="36"
                                                       Height="36"
                                                       Stretch="UniformToFill"
                                                       Source="{Binding ImageFilePath, Converter={x:Static conv:ImagePathToBitmapConverter.Instance}}" />
                                            </Border>

                                            <TextBlock Grid.Column="1"
                                                       Grid.Row="0"
                                                       Text="{Binding ImageFilePath, Converter={x:Static conv:ImagePathToImageInfoConverter.Instance}}"
                                                       Classes="rowtext"
                                                       FontSize="13"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="1"
                                        Height="1"
                                        Background="{DynamicResource AppDivider}"
                                        HorizontalAlignment="Stretch" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
            </DockPanel>

            <Canvas IsHitTestVisible="False">
                <Border Name="DragGhostRoot"
                        IsVisible="False"
                        Background="{DynamicResource AppPanelBackground}"
                        BorderBrush="{DynamicResource AppBorder}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12,8"
                        Opacity="0.95">
                    <TextBlock Name="DragGhostText"
                               Foreground="{DynamicResource AppForeground}"
                               FontSize="12"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" />
                </Border>
            </Canvas>

            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="12"
                    Padding="12,8"
                    Background="{DynamicResource AppToastBackground}"
                    CornerRadius="8"
                    IsVisible="{Binding ToastMessage, Converter={x:Static conv:NotNullOrEmptyToBoolConverter.Instance}}">
                <TextBlock Text="{Binding ToastMessage}"
                           Foreground="{DynamicResource AppToastForeground}" />
            </Border>
        </Grid>
    </Border>

</Window>
