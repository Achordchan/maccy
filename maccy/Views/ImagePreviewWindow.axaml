<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="maccy.Views.ImagePreviewWindow"
        Width="320"
        Height="320"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        CanResize="False"
        SystemDecorations="None"
        Background="Transparent">

  <Border Padding="10"
          Background="{DynamicResource AppPreviewBackground}"
          BorderBrush="{DynamicResource AppDivider}"
          BorderThickness="1"
          CornerRadius="12"
          ClipToBounds="True">
    <Grid Name="RootGrid" RowDefinitions="*,Auto,Auto">
      <Grid Grid.Row="0">
        <Image Name="PreviewImage"
               Stretch="Uniform" />

        <ScrollViewer Name="TextScroll"
                      IsVisible="False">
          <TextBlock Name="PreviewText"
                     TextWrapping="Wrap"
                     Background="Transparent"
                     Foreground="{DynamicResource AppForeground}" />
        </ScrollViewer>
      </Grid>

      <Border Name="PreviewDivider" Grid.Row="1"
              Height="1"
              Background="{DynamicResource AppDivider}"
              Margin="0,8,0,8" />

      <StackPanel Grid.Row="2" Spacing="4">
        <Button Name="OpenOriginalButton"
                HorizontalAlignment="Left"
                Background="{DynamicResource AppPreviewButtonBackground}"
                Foreground="{DynamicResource AppForeground}"
                BorderBrush="{DynamicResource AppDivider}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10,4"
                FontSize="12"
                Content="查看原图"
                Click="OnOpenOriginalClick" />
        <StackPanel Name="SourcePanel" Orientation="Horizontal" Spacing="6" IsVisible="False">
          <Image Name="SourceIcon"
                 Width="18" Height="18"
                 Stretch="UniformToFill" />
          <TextBlock Name="SourceText"
                     Foreground="{DynamicResource AppMutedForeground}"
                     FontSize="11"
                     TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock Name="MetaLine"
                   Foreground="{DynamicResource AppMutedForeground}"
                   FontSize="11"
                   TextWrapping="Wrap" />
        <TextBlock Name="TimeLine"
                   Foreground="{DynamicResource AppMuted2Foreground}"
                   FontSize="11"
                   TextWrapping="Wrap" />
        <TextBlock Name="NoteLine"
                   Foreground="{DynamicResource AppForeground}"
                   FontSize="12"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
