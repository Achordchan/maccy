<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:maccy.ViewModels"
        xmlns:conv="using:maccy.Converters"
        x:Class="maccy.Views.PreferencesWindow"
        x:DataType="vm:PreferencesWindowViewModel"
        Width="460"
        Height="560"
        MinWidth="460"
        MinHeight="560"
        CanResize="False"
        Title="设置"
        Background="{DynamicResource AppBackground}">

  <Border Padding="14"
          Background="{DynamicResource AppBackground}">
    <Grid>
      <Grid RowDefinitions="*,Auto">
        <TabControl Grid.Row="0">
        <TabItem Header="通用">
          <ScrollViewer VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12" Margin="0,10,0,0">
              <CheckBox Content="开机启动"
                        IsChecked="{Binding StartWithWindows}"
                        Foreground="{DynamicResource AppForeground}" />

              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Width="120"
                           Text="主题"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AppForeground}" />
                <ComboBox Width="180"
                          ItemsSource="{Binding ThemeOptions}"
                          SelectedItem="{Binding SelectedTheme}"
                          Background="{DynamicResource AppControlBackground}"
                          Foreground="{DynamicResource AppForeground}"
                          BorderBrush="{DynamicResource AppBorder}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Display}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>

              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Width="120"
                           Text="检查更新"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AppForeground}" />
                <Button Content="检查"
                        Command="{Binding CheckUpdatesCommand}"
                        Background="{DynamicResource AppControlBackground}"
                        Foreground="{DynamicResource AppForeground}"
                        BorderBrush="{DynamicResource AppBorder}" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="内容">
          <ScrollViewer VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12" Margin="0,10,0,0">
              <TextBlock Text="历史"
                         FontWeight="Bold"
                         Foreground="{DynamicResource AppForeground}" />

              <CheckBox Content="合并重复内容"
                        IsChecked="{Binding MergeDuplicates}"
                        Foreground="{DynamicResource AppForeground}" />
              <CheckBox Content="收藏项不计入上限"
                        IsChecked="{Binding ExcludePinnedFromLimits}"
                        Foreground="{DynamicResource AppForeground}" />

              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Width="120"
                           Text="最大条目"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AppForeground}" />
                <TextBox Width="100"
                         Text="{Binding MaxItemsText}"
                         Background="{DynamicResource AppControlBackground}"
                         Foreground="{DynamicResource AppForeground}"
                         BorderBrush="{DynamicResource AppBorder}" />
              </StackPanel>

              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Width="120"
                           Text="最大容量（MB）"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AppForeground}" />
                <TextBox Width="100"
                         Text="{Binding MaxMegabytesText}"
                         Background="{DynamicResource AppControlBackground}"
                         Foreground="{DynamicResource AppForeground}"
                         BorderBrush="{DynamicResource AppBorder}" />
              </StackPanel>

              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Width="120"
                           Text="存储位置"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AppForeground}" />
                <Button Content="打开"
                        Command="{Binding OpenStorageCommand}"
                        Background="{DynamicResource AppControlBackground}"
                        Foreground="{DynamicResource AppForeground}"
                        BorderBrush="{DynamicResource AppBorder}" />
              </StackPanel>

              <Border Height="1"
                      Background="{DynamicResource AppDivider}"
                      Margin="0,4,0,4" />

              <TextBlock Text="捕获"
                         FontWeight="Bold"
                         Foreground="{DynamicResource AppForeground}" />

              <CheckBox Content="捕获文本"
                        IsChecked="{Binding CaptureText}"
                        Foreground="{DynamicResource AppForeground}" />
              <CheckBox Content="捕获图片"
                        IsChecked="{Binding CaptureImages}"
                        Foreground="{DynamicResource AppForeground}" />
              <CheckBox Content="捕获文件"
                        IsChecked="{Binding CaptureFiles}"
                        Foreground="{DynamicResource AppForeground}" />

              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Width="120"
                           Text="文件后缀"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AppForeground}" />
                <TextBox Width="240"
                         Text="{Binding CaptureFileExtensionsText}"
                         Watermark=".pdf,.docx,.txt（留空=全部）"
                         Background="{DynamicResource AppControlBackground}"
                         Foreground="{DynamicResource AppForeground}"
                         BorderBrush="{DynamicResource AppBorder}" />
              </StackPanel>

              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Width="120"
                           Text="单文件上限（MB）"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AppForeground}" />
                <TextBox Width="100"
                         Text="{Binding CaptureFileMaxMegabytesText}"
                         Watermark="20"
                         Background="{DynamicResource AppControlBackground}"
                         Foreground="{DynamicResource AppForeground}"
                         BorderBrush="{DynamicResource AppBorder}" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="货架">
          <ScrollViewer VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12" Margin="0,10,0,0">
              <CheckBox Content="启用货架"
                        IsChecked="{Binding ShelfEnabled}"
                        Foreground="{DynamicResource AppForeground}" />

              <StackPanel IsVisible="{Binding ShelfEnabled}"
                          Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Width="120"
                             Text="触发键"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource AppForeground}" />
                  <ComboBox Width="220"
                            ItemsSource="{Binding ShelfTriggerModifierOptions}"
                            SelectedItem="{Binding SelectedShelfTriggerModifier}"
                            Background="{DynamicResource AppControlBackground}"
                            Foreground="{DynamicResource AppForeground}"
                            BorderBrush="{DynamicResource AppBorder}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Display}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>

                <Border Background="{DynamicResource AppControlBackground}"
                        BorderBrush="{DynamicResource AppBorder}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10">
                  <TextBlock Text="按住触发键，在任意位置按住鼠标左键并快速左右摇晃，即可唤出货架窗口。"
                             Foreground="{DynamicResource AppMutedForeground}"
                             FontSize="12"
                             TextWrapping="Wrap" />
                </Border>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="云同步">
          <ScrollViewer VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16" Margin="0,10,0,0">
              <StackPanel Spacing="8">
                <TextBlock Text="账户"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppForeground}" />
                <Grid ColumnDefinitions="120,*"
                      ColumnSpacing="8">
                  <TextBlock Grid.Column="0"
                             Text="登录状态"
                             VerticalAlignment="Top"
                             Foreground="{DynamicResource AppMutedForeground}" />
                  <StackPanel Grid.Column="1" Spacing="8">
                    <TextBlock Text="{Binding AuthStatusText}"
                               Foreground="{DynamicResource AppForeground}" />

                    <Border IsVisible="{Binding IsLoggedIn, Converter={x:Static conv:InverseBoolConverter.Instance}}"
                            Padding="12"
                            CornerRadius="10"
                            Background="{DynamicResource AppControlBackground}"
                            BorderBrush="{DynamicResource AppBorder}"
                            BorderThickness="1">
                      <StackPanel Spacing="10">
                        <TextBox Text="{Binding AuthEmailText}"
                                 HorizontalAlignment="Stretch"
                                 Watermark="请输入邮箱"
                                 Background="{DynamicResource AppBackground}"
                                 Foreground="{DynamicResource AppForeground}"
                                 BorderBrush="{DynamicResource AppBorder}" />
                        <TextBox Text="{Binding AuthPasswordText}"
                                 HorizontalAlignment="Stretch"
                                 PasswordChar="*"
                                 Watermark="请输入密码"
                                 Background="{DynamicResource AppBackground}"
                                 Foreground="{DynamicResource AppForeground}"
                                 BorderBrush="{DynamicResource AppBorder}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Button Content="登录"
                                  Command="{Binding LoginCommand}"
                                  IsEnabled="{Binding AuthBusy, Converter={x:Static conv:InverseBoolConverter.Instance}}"
                                  Background="{DynamicResource AppControlBackground}"
                                  Foreground="{DynamicResource AppForeground}"
                                  BorderBrush="{DynamicResource AppBorder}"
                                  Padding="12,6" />
                          <Button Content="注册"
                                  Command="{Binding RegisterCommand}"
                                  IsEnabled="{Binding AuthBusy, Converter={x:Static conv:InverseBoolConverter.Instance}}"
                                  Background="{DynamicResource AppControlBackground}"
                                  Foreground="{DynamicResource AppForeground}"
                                  BorderBrush="{DynamicResource AppBorder}"
                                  Padding="12,6" />
                          <Button Content="忘记密码"
                                  Command="{Binding ToggleForgotPasswordCommand}"
                                  Background="{DynamicResource AppControlBackground}"
                                  Foreground="{DynamicResource AppForeground}"
                                  BorderBrush="{DynamicResource AppBorder}"
                                  Padding="12,6" />
                        </StackPanel>
                      </StackPanel>
                    </Border>

                    <StackPanel Spacing="8"
                                IsVisible="{Binding IsLoggedIn}">
                      <StackPanel Orientation="Horizontal"
                                  Spacing="8">
                        <Button Content="退出登录"
                                Command="{Binding LogoutCommand}"
                                Background="{DynamicResource AppControlBackground}"
                                Foreground="{DynamicResource AppForeground}"
                                BorderBrush="{DynamicResource AppBorder}"
                                Padding="12,6" />
                        <Button Content="修改密码"
                                Command="{Binding ToggleChangePasswordCommand}"
                                Background="{DynamicResource AppControlBackground}"
                                Foreground="{DynamicResource AppForeground}"
                                BorderBrush="{DynamicResource AppBorder}"
                                Padding="12,6" />
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </StackPanel>

              <Border IsVisible="{Binding IsLoggedIn, Converter={x:Static conv:InverseBoolConverter.Instance}}"
                      Padding="12"
                      CornerRadius="10"
                      Background="{DynamicResource AppControlBackground}"
                      BorderBrush="{DynamicResource AppBorder}"
                      BorderThickness="1">
                <TextBlock Text="登录后即可启用云同步，剪贴板历史将自动同步到云端。"
                           Foreground="{DynamicResource AppMutedForeground}"
                           TextWrapping="Wrap" />
              </Border>

              <StackPanel Spacing="8"
                          IsVisible="{Binding IsLoggedIn}">
                <TextBlock Text="同步"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppForeground}" />
                <Grid ColumnDefinitions="120,*"
                      ColumnSpacing="8">
                  <TextBlock Grid.Column="0"
                             Text="手动操作"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource AppMutedForeground}" />
                  <StackPanel Grid.Column="1"
                              Orientation="Horizontal"
                              Spacing="8">
                    <Button Content="立即同步"
                            Command="{Binding SyncNowCommand}"
                            IsEnabled="{Binding NasBusy, Converter={x:Static conv:InverseBoolConverter.Instance}}"
                            Background="{DynamicResource AppControlBackground}"
                            Foreground="{DynamicResource AppForeground}"
                            BorderBrush="{DynamicResource AppBorder}"
                            Padding="12,6" />
                  </StackPanel>
                </Grid>
              </StackPanel>

              <StackPanel Spacing="8"
                          IsVisible="{Binding IsLoggedIn}">
                <TextBlock Text="订阅"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppForeground}" />

                <Grid ColumnDefinitions="120,*"
                      ColumnSpacing="8">
                  <TextBlock Grid.Column="0"
                             Text="订阅状态"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource AppMutedForeground}" />
                  <StackPanel Grid.Column="1"
                              Orientation="Horizontal"
                              Spacing="8">
                    <TextBlock Text="{Binding SubscriptionStatusText}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AppForeground}" />
                    <Button Content="刷新"
                            Command="{Binding RefreshSubscriptionCommand}"
                            Background="{DynamicResource AppControlBackground}"
                            Foreground="{DynamicResource AppForeground}"
                            BorderBrush="{DynamicResource AppBorder}"
                            Padding="8,4" />
                  </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="120,*"
                      ColumnSpacing="8">
                  <TextBlock Grid.Column="0"
                             Text="套餐"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource AppMutedForeground}" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding SubscriptionTierText}"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource AppForeground}" />
                </Grid>

                <Grid ColumnDefinitions="120,*"
                      ColumnSpacing="8">
                  <TextBlock Grid.Column="0"
                             Text="存储占用"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource AppMutedForeground}" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding SubscriptionStorageText}"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource AppForeground}" />
                </Grid>

                <Grid ColumnDefinitions="120,*"
                      ColumnSpacing="8">
                  <TextBlock Grid.Column="0"
                             Text="保留天数"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource AppMutedForeground}" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding SubscriptionRetentionText}"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource AppForeground}" />
                </Grid>

                <Grid ColumnDefinitions="120,*"
                      ColumnSpacing="8">
                  <TextBlock Grid.Column="0"
                             Text="超限状态"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource AppMutedForeground}" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding SubscriptionOverLimitText}"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource AppForeground}" />
                </Grid>

                <Grid ColumnDefinitions="120,*"
                      ColumnSpacing="8">
                  <TextBlock Grid.Column="0"
                             Text="兑换卡密"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource AppMutedForeground}" />
                  <StackPanel Grid.Column="1"
                              Orientation="Horizontal"
                              Spacing="8">
                    <TextBox Width="160"
                             Text="{Binding RedeemCodeText}"
                             Watermark="输入卡密"
                             Background="{DynamicResource AppControlBackground}"
                             Foreground="{DynamicResource AppForeground}"
                             BorderBrush="{DynamicResource AppBorder}" />
                    <Button Content="兑换"
                            Command="{Binding RedeemCardCommand}"
                            Background="{DynamicResource AppControlBackground}"
                            Foreground="{DynamicResource AppForeground}"
                            BorderBrush="{DynamicResource AppBorder}"
                            Padding="12,6" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Spacing="10">
          <Border Height="1"
                  Background="{DynamicResource AppDivider}"
                  Margin="0,10,0,0" />
          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      Spacing="10">
            <Button Content="关闭"
                    Command="{Binding CloseCommand}"
                    Background="{DynamicResource AppControlBackground}"
                    Foreground="{DynamicResource AppForeground}"
                    BorderBrush="{DynamicResource AppBorder}" />
          </StackPanel>
        </StackPanel>
      </Grid>

      <Grid Panel.ZIndex="50"
            IsVisible="{Binding IsPasswordDialogVisible}"
            Background="#99000000">
        <Border Width="392"
                Padding="18"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="16"
                Background="{DynamicResource AppPanelBackground}"
                BorderBrush="{DynamicResource AppBorder}"
                BorderThickness="1">
          <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Bottom" Spacing="12">
              <Border Height="1"
                      Background="{DynamicResource AppDivider}"
                      Margin="0,6,0,0" />
              <StackPanel Orientation="Horizontal"
                          HorizontalAlignment="Right"
                          Spacing="8">
                <Button Content="取消"
                        Command="{Binding ClosePasswordDialogCommand}"
                        Background="{DynamicResource AppControlBackground}"
                        Foreground="{DynamicResource AppForeground}"
                        BorderBrush="{DynamicResource AppBorder}"
                        Padding="12,6" />
                <Button Content="重置密码"
                        IsVisible="{Binding ShowForgotPasswordForm}"
                        Command="{Binding ResetPasswordCommand}"
                        IsEnabled="{Binding PasswordCodeBusy, Converter={x:Static conv:InverseBoolConverter.Instance}}"
                        Padding="12,6" />
                <Button Content="确认修改"
                        IsVisible="{Binding ShowChangePasswordForm}"
                        Command="{Binding ChangePasswordCommand}"
                        IsEnabled="{Binding PasswordCodeBusy, Converter={x:Static conv:InverseBoolConverter.Instance}}"
                        Padding="12,6" />
              </StackPanel>
            </StackPanel>

            <StackPanel Spacing="12">
              <StackPanel Spacing="4">
                <TextBlock Text="找回密码"
                           IsVisible="{Binding ShowForgotPasswordForm}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppForeground}" />
                <TextBlock Text="修改密码"
                           IsVisible="{Binding ShowChangePasswordForm}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppForeground}" />
                <TextBlock Text="验证码会发送到你的邮箱，修改成功后需要重新登录。"
                           Foreground="{DynamicResource AppMutedForeground}"
                           TextWrapping="Wrap" />
              </StackPanel>

              <StackPanel Spacing="10">
                <StackPanel Spacing="5"
                            IsVisible="{Binding ShowForgotPasswordForm}">
                  <TextBlock Text="邮箱"
                             FontSize="12"
                             Foreground="{DynamicResource AppMutedForeground}" />
                  <TextBox Text="{Binding AuthEmailText}"
                           HorizontalAlignment="Stretch"
                           Watermark="请输入邮箱"
                           Background="{DynamicResource AppBackground}"
                           Foreground="{DynamicResource AppForeground}"
                           BorderBrush="{DynamicResource AppBorder}" />
                </StackPanel>

                <StackPanel Spacing="5"
                            IsVisible="{Binding ShowChangePasswordForm}">
                  <TextBlock Text="当前账号"
                             FontSize="12"
                             Foreground="{DynamicResource AppMutedForeground}" />
                  <Border Padding="10,8"
                          CornerRadius="8"
                          Background="{DynamicResource AppBackground}"
                          BorderBrush="{DynamicResource AppBorder}"
                          BorderThickness="1">
                    <TextBlock Text="{Binding AuthStatusText}"
                               Foreground="{DynamicResource AppForeground}" />
                  </Border>
                </StackPanel>

                <StackPanel Spacing="5">
                  <TextBlock Text="验证码"
                             FontSize="12"
                             Foreground="{DynamicResource AppMutedForeground}" />
                  <Grid ColumnDefinitions="*,Auto"
                        ColumnSpacing="8">
                    <TextBox Grid.Column="0"
                             Text="{Binding PasswordCodeText}"
                             HorizontalAlignment="Stretch"
                             Watermark="6 位邮箱验证码"
                             Background="{DynamicResource AppBackground}"
                             Foreground="{DynamicResource AppForeground}"
                             BorderBrush="{DynamicResource AppBorder}" />
                    <Button Grid.Column="1"
                            Content="{Binding PasswordCodeButtonText}"
                            Command="{Binding SendPasswordCodeCommand}"
                            Background="{DynamicResource AppControlBackground}"
                            Foreground="{DynamicResource AppForeground}"
                            BorderBrush="{DynamicResource AppBorder}"
                            Padding="12,6" />
                  </Grid>
                </StackPanel>

                <StackPanel Spacing="5">
                  <TextBlock Text="新密码"
                             FontSize="12"
                             Foreground="{DynamicResource AppMutedForeground}" />
                  <TextBox Text="{Binding NewPasswordText}"
                           HorizontalAlignment="Stretch"
                           PasswordChar="*"
                           Watermark="至少 8 位"
                           Background="{DynamicResource AppBackground}"
                           Foreground="{DynamicResource AppForeground}"
                           BorderBrush="{DynamicResource AppBorder}" />
                </StackPanel>

                <StackPanel Spacing="5">
                  <TextBlock Text="确认新密码"
                             FontSize="12"
                             Foreground="{DynamicResource AppMutedForeground}" />
                  <TextBox Text="{Binding ConfirmNewPasswordText}"
                           HorizontalAlignment="Stretch"
                           PasswordChar="*"
                           Watermark="再次输入新密码"
                           Background="{DynamicResource AppBackground}"
                           Foreground="{DynamicResource AppForeground}"
                           BorderBrush="{DynamicResource AppBorder}" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </DockPanel>
        </Border>
      </Grid>

      <Border HorizontalAlignment="Center"
              VerticalAlignment="Bottom"
              Margin="12"
              Padding="12,8"
              Background="{DynamicResource AppToastBackground}"
              CornerRadius="8"
              IsVisible="{Binding ToastMessage, Converter={x:Static conv:NotNullOrEmptyToBoolConverter.Instance}}">
        <TextBlock Text="{Binding ToastMessage}"
                   Foreground="{DynamicResource AppToastForeground}" />
      </Border>
    </Grid>
  </Border>
</Window>
