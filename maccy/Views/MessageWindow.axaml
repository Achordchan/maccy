<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="maccy.Views.MessageWindow"
        Width="480"
        Height="220"
        CanResize="False"
        Background="{DynamicResource AppBackground}">

  <Border Padding="16" Background="{DynamicResource AppBackground}">
    <DockPanel LastChildFill="True">

      <StackPanel DockPanel.Dock="Bottom" Spacing="10">
        <Border Height="1" Background="{DynamicResource AppDivider}" Margin="0,10,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
          <Button x:Name="OkButton" Content="确定" />
        </StackPanel>
      </StackPanel>

      <StackPanel Spacing="10">
        <TextBlock x:Name="TitleText" Text="" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AppForeground}" />
        <Border Background="{DynamicResource AppPanelBackground}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="10" Padding="12">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="{DynamicResource AppForeground}" />
          </ScrollViewer>
        </Border>
      </StackPanel>

    </DockPanel>
  </Border>
</Window>
