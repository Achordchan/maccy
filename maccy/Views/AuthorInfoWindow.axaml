<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="maccy.Views.AuthorInfoWindow"
        Width="420"
        Height="320"
        CanResize="False"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        SystemDecorations="None"
        Background="Transparent">

  <Border Background="{DynamicResource AppPanelBackground}"
          BorderBrush="{DynamicResource AppBorder}"
          BorderThickness="1"
          CornerRadius="16"
          Padding="18"
          BoxShadow="0 12 28 0 #22000000">

    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">

      <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="14">
        <Border Width="64"
                Height="64"
                CornerRadius="32"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                ClipToBounds="True"
                BorderBrush="{DynamicResource AppBorder}"
                BorderThickness="1">
          <Image Name="AvatarImage" Stretch="UniformToFill" />
        </Border>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
          <TextBlock Text="Achord"
                     Foreground="{DynamicResource AppForeground}"
                     FontSize="16"
                     FontWeight="SemiBold" />
          <TextBlock Text="作者"
                     Foreground="{DynamicResource AppMutedForeground}"
                     FontSize="12" />
        </StackPanel>
      </Grid>

      <Border Grid.Row="1" Height="1" Background="{DynamicResource AppDivider}" />

      <StackPanel Grid.Row="2" Spacing="10">

        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <Border Width="26"
                  Height="26"
                  CornerRadius="13"
                  Background="{DynamicResource AppControlBackground}"
                  BorderBrush="{DynamicResource AppBorder}"
                  BorderThickness="1"
                  VerticalAlignment="Center">
            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AppMutedForeground}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Grid.Column="1" Text="Tel: 13160235855" Foreground="{DynamicResource AppForeground}" FontSize="13" VerticalAlignment="Center" />
        </Grid>

        <Button Background="Transparent" BorderThickness="0" Padding="0" Click="OnEmailClick">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <Border Width="26"
                    Height="26"
                    CornerRadius="13"
                    Background="{DynamicResource AppControlBackground}"
                    BorderBrush="{DynamicResource AppBorder}"
                    BorderThickness="1"
                    VerticalAlignment="Center">
              <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AppMutedForeground}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="2">
              <TextBlock Text="Email" Foreground="{DynamicResource AppMuted2Foreground}" FontSize="11" />
              <TextBlock Text="achordchan@gmail.com" Foreground="{DynamicResource AppForeground}" FontSize="13" />
            </StackPanel>
          </Grid>
        </Button>

      </StackPanel>

      <Grid Grid.Row="3" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
        <Button Grid.Row="0" Grid.Column="0"
                Background="{DynamicResource AppControlBackground}"
                BorderBrush="{DynamicResource AppBorder}"
                Foreground="{DynamicResource AppForeground}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="10,8"
                Click="OnProjectClick">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AppMutedForeground}" FontSize="12" VerticalAlignment="Center" />
            <TextBlock Text="项目地址" FontSize="12" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <Button Grid.Row="0" Grid.Column="1"
                Background="{DynamicResource AppControlBackground}"
                BorderBrush="{DynamicResource AppBorder}"
                Foreground="{DynamicResource AppForeground}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="10,8"
                Click="OnPrivacyClick">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AppMutedForeground}" FontSize="12" VerticalAlignment="Center" />
            <TextBlock Text="隐私条款" FontSize="12" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <Button Grid.Row="1" Grid.Column="0"
                Background="{DynamicResource AppControlBackground}"
                BorderBrush="{DynamicResource AppBorder}"
                Foreground="{DynamicResource AppForeground}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="10,8"
                Click="OnLicenseClick">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AppMutedForeground}" FontSize="12" VerticalAlignment="Center" />
            <TextBlock Text="开源协议" FontSize="12" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <Button Grid.Row="1" Grid.Column="1"
                Background="{DynamicResource AppControlBackground}"
                BorderBrush="{DynamicResource AppBorder}"
                Foreground="{DynamicResource AppForeground}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="10,8"
                Click="OnSponsorClick">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AppMutedForeground}" FontSize="12" VerticalAlignment="Center" />
            <TextBlock Text="赞助我" FontSize="12" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>

    </Grid>
  </Border>
</Window>
