<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="maccy.Views.AuthorInfoWindow"
        Width="484"
        Height="304"
        CanResize="False"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        SystemDecorations="None"
        Background="Transparent">

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AuthorCardBackground" Color="#FF171717" />
          <SolidColorBrush x:Key="AuthorCardBorder" Color="#FF2D2D2D" />
          <SolidColorBrush x:Key="AuthorRaisedBackground" Color="#FF202020" />
          <SolidColorBrush x:Key="AuthorRaisedBorder" Color="#FF2E2E2E" />
          <SolidColorBrush x:Key="AuthorPrimaryBackground" Color="#FFF1ECE7" />
          <SolidColorBrush x:Key="AuthorPrimaryForeground" Color="#FF171717" />
          <SolidColorBrush x:Key="AuthorAccentForeground" Color="#FFB67D58" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AuthorCardBackground" Color="#FFFDFCFB" />
          <SolidColorBrush x:Key="AuthorCardBorder" Color="#FFE6DDD6" />
          <SolidColorBrush x:Key="AuthorRaisedBackground" Color="#FFF4EFEB" />
          <SolidColorBrush x:Key="AuthorRaisedBorder" Color="#FFE6D8CE" />
          <SolidColorBrush x:Key="AuthorPrimaryBackground" Color="#FF8F5A3C" />
          <SolidColorBrush x:Key="AuthorPrimaryForeground" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="AuthorAccentForeground" Color="#FF8F5A3C" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Border Background="{DynamicResource AuthorCardBackground}"
          BorderBrush="{DynamicResource AuthorCardBorder}"
          BorderThickness="1"
          CornerRadius="20"
          Padding="18"
          BoxShadow="0 18 38 0 #22000000, 0 3 10 0 #12000000">

    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
        <Border Width="78"
                Height="78"
                CornerRadius="22"
                ClipToBounds="True"
                BorderBrush="{DynamicResource AuthorCardBorder}"
                BorderThickness="1"
                BoxShadow="0 10 24 0 #20000000">
          <Grid>
            <Border>
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="#FFAE7550" Offset="0" />
                  <GradientStop Color="#FF2A2A2A" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
            </Border>
            <TextBlock Text="A+"
                       Foreground="White"
                       FontFamily="Georgia"
                       FontSize="32"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="0,-2,0,0" />
            <Image Name="AvatarImage"
                   Stretch="UniformToFill"
                   Opacity="0" />
          </Grid>
        </Border>

        <StackPanel Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="3">
          <TextBlock Text="AUTHOR"
                     Foreground="{DynamicResource AuthorAccentForeground}"
                     FontSize="10"
                     FontWeight="SemiBold"
                     LetterSpacing="2" />
          <TextBlock Text="Achord Chan"
                     Foreground="{DynamicResource AppForeground}"
                     FontFamily="Georgia"
                     FontSize="29"
                     FontWeight="SemiBold" />
          <TextBlock Text="Maccy 作者"
                     Foreground="{DynamicResource AppMutedForeground}"
                     FontSize="14" />
          <TextBlock Text="Independent Builder"
                     Foreground="{DynamicResource AuthorAccentForeground}"
                     FontSize="11"
                     LetterSpacing="0.6" />
        </StackPanel>
      </Grid>

      <Border Grid.Row="1"
              Background="{DynamicResource AuthorRaisedBackground}"
              BorderBrush="{DynamicResource AuthorRaisedBorder}"
              BorderThickness="1"
              CornerRadius="16"
              Padding="14,12">
        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="9">
          <Button Grid.Row="0"
                  Background="Transparent"
                  BorderThickness="0"
                  Padding="0"
                  HorizontalContentAlignment="Stretch"
                  Click="OnEmailClick">
            <Grid ColumnDefinitions="44,*" ColumnSpacing="12">
              <TextBlock Text="Email"
                         Foreground="{DynamicResource AppMuted2Foreground}"
                         FontSize="11"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Column="1"
                         Text="achordchan@gmail.com"
                         Foreground="{DynamicResource AppForeground}"
                         FontSize="14"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center" />
            </Grid>
          </Button>

          <Border Grid.Row="1"
                  Height="1"
                  Background="{DynamicResource AuthorRaisedBorder}" />

          <Grid Grid.Row="2"
                ColumnDefinitions="44,*"
                ColumnSpacing="12">
            <TextBlock Text="Phone"
                       Foreground="{DynamicResource AppMuted2Foreground}"
                       FontSize="11"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       Text="131 6023 5855"
                       Foreground="{DynamicResource AppForeground}"
                       FontSize="14"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center" />
          </Grid>
        </Grid>
      </Border>

      <Grid Grid.Row="2"
            Width="436"
            HorizontalAlignment="Center"
            ColumnDefinitions="101,101,101,101"
            RowDefinitions="64"
            ColumnSpacing="10">
        <Button Grid.Row="0"
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="{DynamicResource AuthorPrimaryBackground}"
                Foreground="{DynamicResource AuthorPrimaryForeground}"
                BorderBrush="Transparent"
                BorderThickness="0"
                CornerRadius="15"
                Padding="12,12"
                HorizontalContentAlignment="Stretch"
                Click="OnProjectClick">
          <StackPanel Spacing="4">
            <TextBlock Text="PROJECT"
                       Foreground="{DynamicResource AuthorAccentForeground}"
                       FontSize="10"
                       FontWeight="SemiBold"
                       LetterSpacing="1.4" />
            <TextBlock Text="项目主页"
                       FontSize="14"
                       FontWeight="SemiBold" />
          </StackPanel>
        </Button>

        <Button Grid.Row="0"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="{DynamicResource AuthorRaisedBackground}"
                Foreground="{DynamicResource AppForeground}"
                BorderBrush="{DynamicResource AuthorRaisedBorder}"
                BorderThickness="1"
                CornerRadius="15"
                Padding="12,12"
                HorizontalContentAlignment="Stretch"
                Click="OnPrivacyClick">
          <StackPanel Spacing="4">
            <TextBlock Text="LEGAL"
                       Foreground="{DynamicResource AuthorAccentForeground}"
                       FontSize="10"
                       FontWeight="SemiBold"
                       LetterSpacing="1.4" />
            <TextBlock Text="隐私条款"
                       FontSize="14"
                       FontWeight="SemiBold" />
          </StackPanel>
        </Button>

        <Button Grid.Row="0"
                Grid.Column="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="{DynamicResource AuthorRaisedBackground}"
                Foreground="{DynamicResource AppForeground}"
                BorderBrush="{DynamicResource AuthorRaisedBorder}"
                BorderThickness="1"
                CornerRadius="15"
                Padding="12,12"
                HorizontalContentAlignment="Stretch"
                Click="OnLicenseClick">
          <StackPanel Spacing="4">
            <TextBlock Text="LICENSE"
                       Foreground="{DynamicResource AuthorAccentForeground}"
                       FontSize="10"
                       FontWeight="SemiBold"
                       LetterSpacing="1.4" />
            <TextBlock Text="开源许可"
                       FontSize="14"
                       FontWeight="SemiBold" />
          </StackPanel>
        </Button>

        <Button Grid.Row="0"
                Grid.Column="3"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="{DynamicResource AuthorRaisedBackground}"
                Foreground="{DynamicResource AppForeground}"
                BorderBrush="{DynamicResource AuthorRaisedBorder}"
                BorderThickness="1"
                CornerRadius="15"
                Padding="12,12"
                HorizontalContentAlignment="Stretch"
                Click="OnSponsorClick">
          <StackPanel Spacing="4">
            <TextBlock Text="SUPPORT"
                       Foreground="{DynamicResource AuthorAccentForeground}"
                       FontSize="10"
                       FontWeight="SemiBold"
                       LetterSpacing="1.4" />
            <TextBlock Text="赞助作者"
                       FontSize="14"
                       FontWeight="SemiBold" />
          </StackPanel>
        </Button>
      </Grid>
    </Grid>
  </Border>
</Window>
