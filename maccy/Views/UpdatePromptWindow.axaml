<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="maccy.Views.UpdatePromptWindow"
        Width="520"
        Height="360"
        CanResize="False"
        Title="发现新版本"
        Background="{DynamicResource AppBackground}">

  <Border Padding="16" Background="{DynamicResource AppBackground}">
    <DockPanel LastChildFill="True">

      <StackPanel DockPanel.Dock="Bottom" Spacing="10">
        <Border Height="1" Background="{DynamicResource AppDivider}" Margin="0,10,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
          <Button x:Name="LaterButton" Content="稍后" />
          <Button x:Name="ExitButton" Content="退出" Background="{DynamicResource AppControlBackground}" Foreground="{DynamicResource AppForeground}" BorderBrush="{DynamicResource AppBorder}" />
          <Button x:Name="UpdateButton" Content="立即更新" />
        </StackPanel>
      </StackPanel>

      <StackPanel Spacing="10">
        <TextBlock x:Name="TitleText" Text="发现新版本" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AppForeground}" />

        <Border Background="{DynamicResource AppPanelBackground}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="10" Padding="12">
          <StackPanel Spacing="8">
            <TextBlock x:Name="VersionText" Text="版本：" Foreground="{DynamicResource AppForeground}" />
            <TextBlock Text="更新内容：" Foreground="{DynamicResource AppMutedForeground}" />
            <Border Background="{DynamicResource AppControlBackground}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="10" Padding="10">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Height="170">
                <TextBlock x:Name="NotesText" TextWrapping="Wrap" Foreground="{DynamicResource AppForeground}" />
              </ScrollViewer>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>

    </DockPanel>
  </Border>
</Window>
